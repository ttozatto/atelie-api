# Conexao com o PostgreSQL. Dentro do Compose o host e "db".
DATABASE_URL=postgresql+psycopg://atelie:atelie@db:5432/atelie

# Origens liberadas no CORS, separadas por virgula.
CORS_ORIGINS=http://localhost:3000

# Credenciais do painel (/admin) e token das rotas de escrita.
# Placeholder de MVP academico: usuario unico, senha em texto puro no ambiente e token
# fixo sem expiracao. NAO e autenticacao de verdade: nao usar em producao.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=troque-esta-senha
ADMIN_TOKEN=troque-este-token

# Armazenamento de objetos com API compativel com S3 (RustFS no compose, S3 na AWS).
S3_ENDPOINT_URL=http://storage:9000
S3_BUCKET=atelie-media
S3_ACCESS_KEY=atelie
S3_SECRET_KEY=troque-esta-chave

# Servico externo de CEP, consumido pela API (nunca pelo navegador).
VIACEP_BASE_URL=https://viacep.com.br/ws
VIACEP_TIMEOUT_SECONDS=5
